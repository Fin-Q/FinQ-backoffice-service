# Existing FinQ Spring API
FINQ_API_BASE_URL=http://localhost:8080
# Spring의 BACKOFFICE_API_KEY와 같은 32자 이상의 랜덤값
BACKOFFICE_API_KEY=replace-with-at-least-32-random-characters

# Backoffice administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters

# Application
APP_TIMEZONE=Asia/Seoul
# 로컬 UI 확인용. 운영 환경에서는 반드시 false 또는 미설정
DASHBOARD_DEMO_MODE=false
